  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Registrar Green action: New event, Register, Save.",
      "html": "<button class=\"ds-btn ds-btn-primary\">New event</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border-radius:6px;font:600 14px/1 var(--font-sans,'Public Sans Variable',system-ui,sans-serif);white-space:nowrap;cursor:pointer;transition:background-color 150ms,color 150ms,border-color 150ms}.ds-btn:focus-visible{outline:2px solid var(--color-ink,#14201a);outline-offset:2px}.ds-btn:disabled{opacity:.55;cursor:not-allowed}.ds-btn-primary{background:var(--color-rail,#17392b);color:#fff;border:1px solid var(--color-rail,#17392b)}.ds-btn-primary:hover{background:var(--color-rail-deep,#0e2219)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Green outline for a second action beside a primary.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Add people</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 16px;border-radius:6px;font:600 14px/1 var(--font-sans,'Public Sans Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 150ms}.ds-btn:focus-visible{outline:2px solid var(--color-ink,#14201a);outline-offset:2px}.ds-btn-secondary{background:#fff;color:var(--color-rail,#17392b);border:1px solid var(--color-rail,#17392b)}.ds-btn-secondary:hover{background:var(--color-mint,#e3eee7)}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "The default button: Leave, Previous, Keep it.",
      "html": "<button class=\"ds-btn ds-btn-quiet\">Leave event</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 16px;border-radius:6px;font:600 14px/1 var(--font-sans,'Public Sans Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 150ms}.ds-btn:focus-visible{outline:2px solid var(--color-ink,#14201a);outline-offset:2px}.ds-btn-quiet{background:#fff;color:var(--color-ink,#14201a);border:1px solid var(--color-field,#c2cbc4)}.ds-btn-quiet:hover{background:var(--color-quiet,#eef1ee)}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Outlined red for destructive triggers; solid red only inside the confirm dialog.",
      "html": "<button class=\"ds-btn ds-btn-danger\">Delete event</button> <button class=\"ds-btn ds-btn-danger-solid\">Delete</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 16px;border-radius:6px;font:600 14px/1 var(--font-sans,'Public Sans Variable',system-ui,sans-serif);cursor:pointer;transition:background-color 150ms}.ds-btn:focus-visible{outline:2px solid var(--color-ink,#14201a);outline-offset:2px}.ds-btn-danger{background:#fff;color:var(--color-red,#a3123a);border:1px solid var(--color-red,#a3123a)}.ds-btn-danger:hover{background:var(--color-pink-row,#fdf1f4)}.ds-btn-danger-solid{background:var(--color-red,#a3123a);color:#fff;border:1px solid var(--color-red,#a3123a)}.ds-btn-danger-solid:hover{background:var(--color-red-ink,#5c0a21)}"
    },
    {
